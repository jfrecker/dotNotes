# dotNotes Docker Compose overrides
#
# Copy this file to `.env` (same directory as docker-compose.yml) and
# uncomment/edit whatever you need. Every value below already has a
# working default baked into docker-compose.yml itself, so
# `docker compose up -d --build` works with zero `.env` file at all —
# this file exists purely so common tweaks (port, vault location, file
# ownership) are a one-line edit instead of hand-editing YAML.
#
# See DEPLOYMENT.md's "Full configuration reference" for what each of
# these actually does.

# Host-side port dotNotes is reachable on (left-hand side of the
# container's port mapping). Change this if 5175 is already taken by
# something else on your machine, e.g. HOST_PORT=8080.
#HOST_PORT=5175

# Host-side path to the vault directory, bind-mounted to /data/vault
# inside the container. Relative paths resolve relative to wherever you
# run `docker compose` from (normally the repo root). Change this to
# point the container at notes that already live somewhere else on
# disk, e.g. VAULT_PATH=/mnt/backup/notes.
#VAULT_PATH=./vault

# uid/gid the container's dotnet process runs as, and therefore which
# uid/gid owns every file it writes into the bind-mounted vault. Set
# both to your own host user's `id -u`/`id -g` so notes the container
# creates are owned by *you* — matters for editing notes directly,
# `git init`-ing the vault for backups, or just being able to `rm -rf`
# it yourself without sudo. Left unset, the container runs as its
# built-in "app" user (uid/gid 1654).
#PUID=1000
#PGID=1000

# Feature toggles — see docs/02-ARCHITECTURE.md's Configuration section.
#SHARING_ENABLED=true
#MCP_ENABLED=true

# Tasks & Kanban — vault folder for new tasks, and the id prefix (TASK-12).
# v0.2.1 renamed the default folder from `tasks` to `Task` (capital T); a
# one-time startup migration moves any existing `task`/`tasks` folder into
# `Task` automatically, so you don't need to change this unless you want a
# different folder name entirely.
#TASKS_FOLDER=Task
#TASKS_ID_PREFIX=TASK

# --- Podman ----------------------------------------------------------
# Both of these are empty by default and change nothing under Docker.
# See README.md's "Running with Podman" for the full story.

# Extra mount options appended to the vault bind mount. Set this to `:Z`
# on an SELinux-enforcing host (Fedora, RHEL, CentOS Stream) or the
# container is denied access to the vault — the symptom is the app
# starting but every note read/write failing. `:Z` relabels the
# directory for this container alone; use `:z` if another container
# mounts the same path too. Relabeling rewrites SELinux labels on
# whatever VAULT_PATH points at, so keep it a directory dedicated to
# dotNotes. Ignored on non-SELinux hosts.
#VAULT_MOUNT_OPTS=:Z

# Rootless Podman only: `keep-id` maps your host user straight through
# into the container, so notes the container writes are owned by *you*
# on the host instead of a subordinate uid you'd need `podman unshare`
# to touch. With this set, PUID/PGID above are unnecessary (and ignored
# — the process already runs as your uid). Leave unset for rootful
# Podman and for Docker.
#USERNS_MODE=keep-id
